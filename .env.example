# Copy to .env and fill in. Never commit .env.

# --- Gnani (Prisma STT + Timbre TTS) — see docs/DOC_DIFFS.md
GNANI_API_KEY=
GNANI_BASE_URL=https://api.vachana.ai
GNANI_STT_MODEL=prisma-v3.0
# comma-separated hints, 1-4 codes (case-sensitive), or indic-auto
GNANI_STT_LANGUAGE=hi-IN,en-IN
# verbatim | transcribe | codemix | transliterate — always sent explicitly
GNANI_STT_FORMAT=transcribe
# send customer names as Prisma v3 keyterms (off until measured)
GNANI_STT_KEYTERMS=false
GNANI_TTS_MODEL=timbre-v3.0
# Shivani (timbre-v3.0; every v3 voice speaks all languages). v2.5 alt: Poorvi (only hi-en v2.5 voice)
GNANI_TTS_VOICE=Shivani
GNANI_TTS_LANGUAGE=hi-en
GNANI_TTS_SPEED=0.95
# account allows 1 active request across STT+TTS
GNANI_MAX_CONCURRENCY=1
# max billable Gnani calls per day in dev (0 = unlimited)
GNANI_CREDIT_GUARD=200

# --- Evon LLM (OpenAI-compatible; llama-server default port 8080, not 8000 = backend)
EVON_BASE_URL=http://localhost:8080/v1
EVON_MODEL=evon
EVON_API_KEY=
EVON_TIMEOUT_S=4
# vLLM response_format=json_object (only if your serving build supports it)
EVON_GUIDED_JSON=false
# hybrid | evon | rules
NLU_MODE=rules

# --- App
APP_ENV=dev
DATABASE_URL=sqlite:///./kirana.db
JWT_SECRET=change-me
FRONTEND_ORIGIN=http://localhost:3000
TZ=Asia/Kolkata

# --- Frontend (read by Next.js)
BACKEND_URL=http://localhost:8000
